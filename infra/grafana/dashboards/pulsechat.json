{
  "uid": "pulsechat-overview",
  "title": "PulseChat \u00b7 Live operations",
  "description": "Live distributed messaging, recovery, and failure-path metrics. Deliberate duplicate, poison, and rate-limit probes populate recovery panels.",
  "tags": [
    "pulsechat",
    "distributed-systems"
  ],
  "schemaVersion": 40,
  "version": 1,
  "timezone": "browser",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "pulsechat-prometheus"
      },
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "id": 1,
      "title": "Connected sockets",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pulsechat_active_connections{service=\"gateway\"})",
          "legendFormat": "sockets",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsechat-prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
