      "id": 7,
      "title": "Consumer backlog \u00b7 current and observed peak",
      "type": "timeseries",
      "description": "Replicas report the same consumer group: take max by partition before summing. Peak preserves brief real backlog between scrapes.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (topic, partition) (pulsechat_consumer_lag{service=\"processor\"}))",
          "legendFormat": "current committed-offset lag",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsechat-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(max by (topic, partition) (pulsechat_consumer_lag_peak{service=\"processor\"}))",
          "legendFormat": "peak since process start",
          "datasource": {
            "type": "prometheus",
            "uid": "pulsechat-prometheus"
          }
        }
